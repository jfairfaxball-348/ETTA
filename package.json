    "check": "npm run typecheck && npm run test && npm run build"
  },
  "dependencies": {
    "three": "0.183.2"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/three": "^0.183.0",
    "typescript": "~5.9.3",
    "vite": "^8.0.3"
  }
}
