{
  "name": "etta",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "description": "ETTA: a session-driven embodied character experiment.",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
